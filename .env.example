# ---------------------------------------------------------------------------
# Canada Post Developer Program credentials. Never commit real values.
# Get a DEVELOPMENT (sandbox) key pair from https://www.canadapost-postescanada.ca/information/app/drc/home
# ---------------------------------------------------------------------------
CANADAPOST_USERNAME=YOUR_API_USERNAME
CANADAPOST_PASSWORD=YOUR_API_PASSWORD
CANADAPOST_CUSTOMER_NUMBER=YOUR_CUSTOMER_NUMBER
# Contract shipping / commercial rates only; leave empty for non-contract accounts.
CANADAPOST_CONTRACT_ID=
# development (sandbox, default) or production. Production shipment creation CHARGES postage.
CANADAPOST_ENVIRONMENT=development

# ---------------------------------------------------------------------------
# Live smoke tests (opt-in; NEVER run in CI). The live suite refuses to run unless the
# environment is development, and it is READ-ONLY (quotes, service discovery, tracking).
#   CANADAPOST_LIVE_TESTS=true npm run test:live
# ---------------------------------------------------------------------------
CANADAPOST_LIVE_TESTS=false
