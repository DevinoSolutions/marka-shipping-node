{
  "name": "@joinmarka/shipping",
  "version": "0.2.0",
  "description": "Marka Shipping: every Marka carrier SDK in one package. Currently Canada Post (rates, shipments, PDF/ZPL labels, manifests, tracking).",
  "license": "MIT",
  "author": "Devino Solutions",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "keywords": [
    "shipping",
    "shipping-labels",
    "carriers",
    "canada-post",
    "canadapost",
    "marka",
    "sdk",
    "typescript"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DevinoSolutions/marka-shipping-node.git",
    "directory": "packages/shipping"
  },
  "homepage": "https://github.com/DevinoSolutions/marka-shipping-node#readme",
  "bugs": {
    "url": "https://github.com/DevinoSolutions/marka-shipping-node/issues"
  },
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "default": "./dist/testing/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.build.json"
  },
  "dependencies": {
    "@joinmarka/canada-post": "^0.1.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
